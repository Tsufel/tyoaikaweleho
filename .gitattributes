# Normalise text to LF in the repo; Windows-only scripts get CRLF on checkout
# whatever core.autocrlf says (cmd.exe misreads LF batch files in blocks).
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf

*.png binary
*.ico binary
*.webp binary
*.jpg binary
*.gif binary
*.wav binary
*.mp3 binary
*.xlsx binary
